# Estado local del CLI de Supabase. Nunca versionarlo: pooler-url contiene la
# cadena de conexión a la base, con credenciales, y este repo es público.
supabase/.temp/

# Salidas de `git show <hash>` que se guardan para revisar un commit a mano.
# Son temporales y siempre duplican algo que ya está en la historia de git:
# nunca tienen que terminar commiteadas.
commit*.patch
